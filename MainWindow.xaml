<Window x:Class="SystemHardwareAudit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spoofed?" Height="930" Width="1100"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#5856D6"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#185856D6"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#0AFFFFFF"/>
        <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#0FFFFFFF"/>
        <SolidColorBrush x:Key="HairlineBrush" Color="#14FFFFFF"/>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#F0222228"/>
            <Setter Property="Foreground" Value="#DFFFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HasDropShadow" Value="True"/>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="Transparent" Padding="2,0">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBody" Background="#2BFFFFFF" CornerRadius="3"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBody" Property="Background" Value="#52FFFFFF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBody" Property="Background" Value="#705856D6"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowDot" TargetType="Button">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Dot" Background="{TemplateBinding Background}" CornerRadius="6" Opacity="0.82" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dot" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarNav" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="14,10"/>
                        <Setter Property="Margin" Value="10,1"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Grid>
                                        <Border x:Name="NavBackground" Background="Transparent" BorderThickness="0" CornerRadius="9"/>
                                        <Border x:Name="NavHover" Background="#0CFFFFFF" CornerRadius="9" Opacity="0" IsHitTestVisible="False"/>
                                        <Border x:Name="ActiveRail" Width="3" Height="18" CornerRadius="2" Background="{StaticResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0"/>
                                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <EventTrigger RoutedEvent="MouseEnter">
                                            <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="NavHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="MouseLeave">
                                            <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="NavHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard>
                                        </EventTrigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="NavBackground" Property="Background" Value="#145856D6"/>
                                            <Setter TargetName="ActiveRail" Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Background" Value="#0AFFFFFF"/>
            <Setter Property="Foreground" Value="#BFFFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBody" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="9" ClipToBounds="True">
                            <Grid>
                                <Border x:Name="ButtonHover" Background="#0EFFFFFF" Opacity="0" IsHitTestVisible="False"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ButtonHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ButtonHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBody" Property="Opacity" Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Background" Value="#345856D6"/>
            <Setter Property="Foreground" Value="#F7FFFFFF"/>
            <Setter Property="Padding" Value="18,8"/>
        </Style>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.36">
                        <DoubleAnimation.EasingFunction><QuinticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="ShellScale" Storyboard.TargetProperty="ScaleX" From="0.994" To="1" Duration="0:0:0.4">
                        <DoubleAnimation.EasingFunction><QuinticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="ShellScale" Storyboard.TargetProperty="ScaleY" From="0.994" To="1" Duration="0:0:0.4">
                        <DoubleAnimation.EasingFunction><QuinticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border x:Name="MainShell" Margin="28" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform><ScaleTransform x:Name="ShellScale" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
        <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.48" Color="Black"/></Border.Effect>

        <Border CornerRadius="18" ClipToBounds="True" BorderThickness="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1D1D20" Offset="0"/>
                    <GradientStop Color="#131316" Offset="0.52"/>
                    <GradientStop Color="#1A1920" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="236"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" BorderThickness="0" Background="#760A0A0D">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,20,0,0">
                                <Button Style="{StaticResource WindowDot}" Background="#FF5F57" Margin="0,0,8,0" Click="CloseButton_Click"/>
                                <Button Style="{StaticResource WindowDot}" Background="#FEBD2F" Margin="0,0,8,0" Click="MinimizeButton_Click"/>
                                <Button Style="{StaticResource WindowDot}" Background="#28C840"/>
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="20,24,18,18">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="10" Background="#12FFFFFF" BorderThickness="0">
                                    <TextBlock Text="s?" Foreground="#EFFFFFFF" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="spoofed?" Foreground="#F5FFFFFF" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="16"/>
                                    <TextBlock Text="samsam.lol" Foreground="#4FFFFFFF" FontFamily="Segoe UI" FontSize="10" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Grid.Row="2" Text="AUDIT CATEGORIES" Foreground="#58FFFFFF" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="10" Margin="22,0,0,8"/>

                            <ListBox Grid.Row="3" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Style="{StaticResource SidebarNav}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" Foreground="#DFFFFFFF" FontSize="12.5" FontWeight="Normal" FontFamily="Segoe UI" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <Border Grid.Column="1" MinWidth="23" Padding="6,2" CornerRadius="7" Background="#09FFFFFF" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding DisplayItemCount}" Foreground="#65FFFFFF" FontSize="10" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                        </Grid>
                    </Border>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                        <Border Grid.Row="0" BorderThickness="0" Background="#12000000">
                            <Grid Margin="28,0,20,0">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedCategoryContextLabel}" Foreground="#905856D6" FontSize="10" FontWeight="Bold" FontFamily="Segoe UI"/>
                                    <TextBlock Text="{Binding SelectedCategory.Name}" Foreground="#E0FFFFFF" FontSize="15" FontWeight="SemiBold" FontFamily="Segoe UI" Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="GhostCleanupBtn" Content="Clean Ghost Devices" Foreground="#FFFF8D8D" Click="GhostCleanup_Click">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource PillButton}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding SelectedCategory.Name}" Value="USB Peripherals"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="Export" Style="{StaticResource PillButton}" Click="ExportButton_Click"/>
                                    <Button Content="Save Baseline" Style="{StaticResource PillButton}" Click="SaveBaseline_Click"/>
                                    <Button Content="Compare" Style="{StaticResource PrimaryButton}" Click="CompareButton_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ScrollViewer x:Name="DetailScrollViewer" Grid.Row="1" Margin="28,22,22,24" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="DetailContent" Margin="0,0,6,0">
                                <StackPanel.RenderTransform><TranslateTransform Y="0"/></StackPanel.RenderTransform>

                                <Border Margin="0,0,0,18" Padding="23,21" CornerRadius="13" BorderThickness="0" Background="#0AFFFFFF">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding SelectedCategoryContextLabel}" Foreground="#905856D6" FontSize="10" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding SelectedCategory.Name}" Foreground="#F3FFFFFF" FontSize="23" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                            <TextBlock Text="{Binding SelectedCategoryDescription}" Foreground="#8FFFFFFF" FontSize="12" FontWeight="Normal" TextWrapping="Wrap" LineHeight="18" Margin="0,8,30,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Padding="13,8" CornerRadius="10" Background="#14FFFFFF" BorderThickness="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding SelectedCategoryItemCount}" Foreground="#F2FFFFFF" FontSize="15" FontWeight="SemiBold"/>
                                                <TextBlock Text=" values" Foreground="#70FFFFFF" FontSize="11" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <ItemsControl ItemsSource="{Binding SelectedCategory.Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Border x:Name="DataRow" Margin="0,0,0,7" Padding="19,16" CornerRadius="11" BorderThickness="0" Background="#0CFFFFFF">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <TextBlock x:Name="LabelText" Grid.Column="0" Text="{Binding Label}" Foreground="#98FFFFFF" FontWeight="Medium" FontSize="12" VerticalAlignment="Center" FontFamily="Segoe UI" TextWrapping="Wrap" Margin="0,0,18,0"/>

                                                        <TextBox x:Name="ValueText" Grid.Column="1" Text="{Binding Value, Mode=OneWay}" Foreground="#F0FFFFFF" FontSize="13" Background="Transparent" BorderThickness="0" IsReadOnly="True" IsReadOnlyCaretVisible="True" Cursor="IBeam" TextWrapping="Wrap" FontFamily="Segoe UI" FontWeight="Medium" VerticalAlignment="Center" SelectionBrush="#5856D6" SelectionOpacity="0.45" CaretBrush="#905856D6" Padding="0"/>

                                                        <Border x:Name="HelpBadge" Grid.Column="2" Width="29" Height="29" CornerRadius="8" Margin="12,0,0,0" Cursor="Help" VerticalAlignment="Center" ToolTip="{Binding TooltipText}" Background="#10FFFFFF" BorderThickness="0">
                                                            <TextBlock Text="?" Foreground="#70FFFFFF" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>

                                                <Border x:Name="PlaceholderRow" Visibility="Collapsed" Margin="0,0,0,6" Padding="22,20" CornerRadius="11" Background="#0AFFFFFF" BorderThickness="0">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <Border Width="34" Height="34" CornerRadius="10" Background="#10FFFFFF" BorderThickness="0" HorizontalAlignment="Center" Margin="0,0,0,10">
                                                            <TextBlock Text="—" Foreground="#50FFFFFF" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding Label}" Foreground="#82FFFFFF" FontSize="12" TextAlignment="Center" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Border>

                                                <Border x:Name="SeparatorRow" Visibility="Collapsed" Height="12" Background="Transparent"/>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <Trigger SourceName="DataRow" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="DataRow" Property="Background" Value="#14FFFFFF"/>
                                                    <Setter TargetName="LabelText" Property="Foreground" Value="#BFFFFFFF"/>
                                                    <Setter TargetName="HelpBadge" Property="Background" Value="#18FFFFFF"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                                    <Setter TargetName="DataRow" Property="Visibility" Value="Collapsed"/>
                                                    <Setter TargetName="PlaceholderRow" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                                    <Setter TargetName="DataRow" Property="Visibility" Value="Collapsed"/>
                                                    <Setter TargetName="SeparatorRow" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Border x:Name="ToastScrim" Panel.ZIndex="200" Grid.ColumnSpan="2" Visibility="Collapsed" Opacity="0" CornerRadius="18" Background="#C5000000">
                        <Border x:Name="ToastCard" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="18" Padding="38,32" MinWidth="390" MaxWidth="470" BorderThickness="0" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#25252B" Offset="0"/><GradientStop Color="#18181D" Offset="1"/></LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.48" Color="Black"/></Border.Effect>
                            <StackPanel>
                                <Border Width="52" Height="52" CornerRadius="15" Background="#205856D6" BorderThickness="0" HorizontalAlignment="Center" Margin="0,0,0,17">
                                    <TextBlock x:Name="ToastIcon" Text="✓" Foreground="#8F8DE8" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="ToastTitle" Foreground="#FFFFFF" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,9"/>
                                <TextBlock x:Name="ToastSubtitle" Foreground="#76FFFFFF" FontFamily="Segoe UI" FontWeight="Light" FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,24" LineHeight="19"/>
                                <Border x:Name="ToastProgressTrack" CornerRadius="2" Height="3" Margin="0,0,0,21" Background="#12FFFFFF" ClipToBounds="True">
                                    <Border x:Name="ToastProgressBar" CornerRadius="2" Height="3" HorizontalAlignment="Left" Width="0">
                                        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#5856D6" Offset="0"/><GradientStop Color="#8B88FF" Offset="1"/></LinearGradientBrush></Border.Background>
                                    </Border>
                                </Border>
                                <Button x:Name="ToastDismissBtn" Content="Dismiss" IsEnabled="False" Opacity="0.3" Click="ToastDismiss_Click" Style="{StaticResource PillButton}" HorizontalAlignment="Center" Padding="26,8"/>
                            </StackPanel>
                        </Border>
                    </Border>
                </Grid>

                <Border x:Name="LoadingScreen" Panel.ZIndex="300" CornerRadius="18" Background="#F2131316">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border x:Name="LoadingMark" Width="46" Height="46" CornerRadius="13" Margin="0,0,0,20" Background="#14FFFFFF" BorderThickness="0">
                            <TextBlock Text="s?" Foreground="#DFFFFFFF" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Border.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.62" To="1" Duration="0:0:0.95" AutoReverse="True" RepeatBehavior="Forever">
                                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                        </Border>
                        <TextBlock Text="Checking this PC" Foreground="#D0FFFFFF" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center"/>
                        <TextBlock Text="Reading hardware IDs" Foreground="#62FFFFFF" FontSize="11" HorizontalAlignment="Center" Margin="0,7,0,18"/>
                        <Border Width="180" Height="2" Background="#18FFFFFF" CornerRadius="1" ClipToBounds="True">
                            <Border Width="54" Height="2" Background="#A05856D6" CornerRadius="1" HorizontalAlignment="Left">
                                <Border.RenderTransform><TranslateTransform x:Name="LoadingSweepTranslate" X="-54"/></Border.RenderTransform>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Border.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="LoadingSweepTranslate" Storyboard.TargetProperty="X" From="-54" To="180" Duration="0:0:1.35" RepeatBehavior="Forever"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                            </Border>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
