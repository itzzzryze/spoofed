<Window x:Class="SystemHardwareAudit.ComparisonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Comparison" Height="820" Width="1280"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#5856D6"/>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#F0222228"/>
            <Setter Property="Foreground" Value="#DFFFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HasDropShadow" Value="True"/>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="Transparent" Padding="2,0">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBody" Background="#2BFFFFFF" CornerRadius="3"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbBody" Property="Background" Value="#52FFFFFF"/></Trigger>
                                                    <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbBody" Property="Background" Value="#705856D6"/></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComparisonTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#70FFFFFF"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="17,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBody" Background="Transparent" BorderThickness="0" CornerRadius="9" Padding="{TemplateBinding Padding}" ClipToBounds="True">
                            <Grid>
                                <Border x:Name="TabHover" Background="#0DFFFFFF" Opacity="0" IsHitTestVisible="False"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="TabHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="TabHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#CFFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBody" Property="Background" Value="#185856D6"/>
                                <Setter Property="Foreground" Value="#F5FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowDot" TargetType="Button">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Dot" Background="{TemplateBinding Background}" CornerRadius="6" Opacity="0.82"/>
                        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Dot" Property="Opacity" Value="1"/></Trigger></ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SelectableValue" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsReadOnlyCaretVisible" Value="True"/>
            <Setter Property="Cursor" Value="IBeam"/>
            <Setter Property="SelectionBrush" Value="#5856D6"/>
            <Setter Property="SelectionOpacity" Value="0.45"/>
            <Setter Property="CaretBrush" Value="#905856D6"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5,4"/>
            <Setter Property="Margin" Value="-5,0,9,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Background" Value="#09FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.34"><DoubleAnimation.EasingFunction><QuinticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="ComparisonShellScale" Storyboard.TargetProperty="ScaleX" From="0.994" To="1" Duration="0:0:0.38"><DoubleAnimation.EasingFunction><QuinticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="ComparisonShellScale" Storyboard.TargetProperty="ScaleY" From="0.994" To="1" Duration="0:0:0.38"><DoubleAnimation.EasingFunction><QuinticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border x:Name="ComparisonShell" Margin="12" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform><ScaleTransform x:Name="ComparisonShellScale" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
        <Border.Effect><DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.48" Color="Black"/></Border.Effect>

        <Border CornerRadius="18" ClipToBounds="True" BorderThickness="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1D1D20" Offset="0"/>
                    <GradientStop Color="#131316" Offset="0.52"/>
                    <GradientStop Color="#1A1920" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="54"/>
                        <RowDefinition Height="62"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" MouseDown="DragWindow_MouseDown" Background="#07000000" Margin="0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                            <Button Style="{StaticResource WindowDot}" Background="#FF5F57" Margin="0,0,8,0" Click="CloseButton_Click"/>
                            <Border Width="12" Height="12" Background="#FEBD2F" CornerRadius="6" Opacity="0.82" Margin="0,0,8,0"/>
                            <Border Width="12" Height="12" Background="#28C840" CornerRadius="6" Opacity="0.82"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="COMPARE" Foreground="#905856D6" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Baseline and current values" Foreground="#E6FFFFFF" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="22,8,22,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Padding="3" CornerRadius="10" BorderThickness="0" Background="#0AFFFFFF" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ImportantTab" GroupName="ComparisonScope" Style="{StaticResource ComparisonTab}" Checked="ImportantTab_Checked">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Important" VerticalAlignment="Center"/>
                                        <Border Margin="8,0,0,0" Padding="7,2" CornerRadius="7" Background="#14FFFFFF" VerticalAlignment="Center"><TextBlock Text="{Binding ImportantItemCount}" FontSize="10" VerticalAlignment="Center"/></Border>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="AllTab" GroupName="ComparisonScope" Style="{StaticResource ComparisonTab}" Checked="AllTab_Checked">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="All values" VerticalAlignment="Center"/>
                                        <Border Margin="8,0,0,0" Padding="7,2" CornerRadius="7" Background="#14FFFFFF" VerticalAlignment="Center"><TextBlock Text="{Binding AllItemCount}" FontSize="10" VerticalAlignment="Center"/></Border>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ActiveScopeDescription}" Foreground="#A0FFFFFF" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="Pass means a targeted ID changed or became unreadable." Foreground="#55FFFFFF" FontSize="10" Margin="0,3,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Padding="10,8" Margin="0,0,6,0" CornerRadius="8" Background="#1234D399" BorderThickness="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="6" Height="6" Fill="#D06EE7B7" VerticalAlignment="Center"/><TextBlock Text="{Binding PassedCount}" Foreground="#F06EE7B7" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="7,0,5,0"/><TextBlock Text="Pass" Foreground="#A0FFFFFF" FontSize="10" VerticalAlignment="Center"/></StackPanel>
                            </Border>
                            <Border Padding="10,8" Margin="0,0,6,0" CornerRadius="8" Background="#120EA5E9" BorderThickness="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="6" Height="6" Fill="#C07DD3FC" VerticalAlignment="Center"/><TextBlock Text="{Binding StableCount}" Foreground="#E07DD3FC" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="7,0,5,0"/><TextBlock Text="Stable" Foreground="#A0FFFFFF" FontSize="10" VerticalAlignment="Center"/></StackPanel>
                            </Border>
                            <Border Padding="10,8" Margin="0,0,6,0" CornerRadius="8" Background="#12F87171" BorderThickness="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="6" Height="6" Fill="#D0FCA5A5" VerticalAlignment="Center"/><TextBlock Text="{Binding AttentionCount}" Foreground="#F0FCA5A5" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="7,0,5,0"/><TextBlock Text="Attention" Foreground="#A0FFFFFF" FontSize="10" VerticalAlignment="Center"/></StackPanel>
                            </Border>
                            <Border Padding="10,8" Margin="0,0,6,0" CornerRadius="8" Background="#12FBBF24" BorderThickness="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="6" Height="6" Fill="#C0FCD34D" VerticalAlignment="Center"/><TextBlock Text="{Binding UnavailableCount}" Foreground="#E0FCD34D" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="7,0,5,0"/><TextBlock Text="Unavailable" Foreground="#A0FFFFFF" FontSize="10" VerticalAlignment="Center"/></StackPanel>
                            </Border>
                            <Border Padding="10,8" CornerRadius="8" Background="#125856D6" BorderThickness="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="6" Height="6" Fill="#B0C7D2FE" VerticalAlignment="Center"/><TextBlock Text="{Binding InformationalCount}" Foreground="#E0C7D2FE" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="7,0,5,0"/><TextBlock Text="Info" Foreground="#A0FFFFFF" FontSize="10" VerticalAlignment="Center"/></StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2" Margin="35,8,37,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="127"/><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="CATEGORY" Foreground="#55FFFFFF" FontWeight="SemiBold" FontSize="10"/>
                        <TextBlock Grid.Column="1" Text="CHECK" Foreground="#55FFFFFF" FontWeight="SemiBold" FontSize="10"/>
                        <TextBlock Grid.Column="2" Text="BASELINE" Foreground="#55FFFFFF" FontWeight="SemiBold" FontSize="10"/>
                        <TextBlock Grid.Column="3" Text="CURRENT" Foreground="#55FFFFFF" FontWeight="SemiBold" FontSize="10"/>
                        <TextBlock Grid.Column="4" Text="ASSESSMENT" Foreground="#55FFFFFF" FontWeight="SemiBold" FontSize="10"/>
                    </Grid>

                    <ScrollViewer x:Name="DataScrollViewer" Grid.Row="3" Margin="22,5,17,18" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.RenderTransform><TranslateTransform Y="0"/></ScrollViewer.RenderTransform>
                        <ItemsControl ItemsSource="{Binding ComparisonItems}" Margin="0,0,7,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Border x:Name="SectionBanner" Visibility="Collapsed" Margin="0,18,0,9" Padding="18,16" CornerRadius="11" BorderThickness="0" Background="#0AFFFFFF">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="3"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <Border Width="3" CornerRadius="2" Background="#805856D6"/>
                                                <Border Grid.Column="1" Padding="9,5" CornerRadius="7" Background="#10FFFFFF" BorderThickness="0" VerticalAlignment="Center" Margin="12,0,0,0">
                                                    <TextBlock Text="{Binding SectionTag}" Foreground="#86FFFFFF" FontSize="9" FontWeight="Bold"/>
                                                </Border>
                                                <StackPanel Grid.Column="2" Margin="13,0,20,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SectionTitle}" Foreground="#F2FFFFFF" FontSize="16" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding SectionSubtitle}" Foreground="#72FFFFFF" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Border Grid.Column="3" Padding="11,7" CornerRadius="8" Background="#0CFFFFFF" BorderThickness="0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding SectionCheckCount}" Foreground="#E0FFFFFF" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Text=" checks" Foreground="#68FFFFFF" FontSize="10" VerticalAlignment="Center" Margin="3,0,0,0"/></StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <Border x:Name="RowBorder" Margin="0,0,0,7" Padding="15,14" CornerRadius="10" Background="{Binding RowBackground}" BorderThickness="0">
                                            <Grid>
                                                <Grid x:Name="RegularRow">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="127"/><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Category}" Foreground="#62FFFFFF" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,13,0"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                                        <TextBlock Text="{Binding Label}" Foreground="#E8FFFFFF" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding ExpectationText}" Foreground="#58FFFFFF" FontSize="10" Margin="0,5,0,0"/>
                                                    </StackPanel>
                                                    <TextBox x:Name="txtOld" Grid.Column="2" Text="{Binding OldValue, Mode=OneWay}" Foreground="#72FFFFFF" Style="{StaticResource SelectableValue}"/>
                                                    <TextBox Grid.Column="3" Text="{Binding NewValue, Mode=OneWay}" Foreground="{Binding CurrentValueForeground}" FontWeight="SemiBold" Style="{StaticResource SelectableValue}"/>
                                                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                                        <Border HorizontalAlignment="Left" CornerRadius="7" Padding="9,4" Background="{Binding ResultBackground}" BorderThickness="0"><TextBlock Text="{Binding ResultTitle}" Foreground="{Binding ResultForeground}" FontSize="10" FontWeight="SemiBold"/></Border>
                                                        <TextBlock Text="{Binding ResultDetail}" Foreground="#82FFFFFF" FontSize="10" TextWrapping="Wrap" LineHeight="15" Margin="0,6,0,0"/>
                                                    </StackPanel>
                                                </Grid>

                                                <Grid x:Name="GroupHeader" Visibility="Collapsed">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="317"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                                                    <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,17,0">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="3"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" CornerRadius="2" Background="{Binding ResultForeground}" Height="36" VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding GroupTitle}" Foreground="#F3FFFFFF" FontSize="16" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding GroupSubtitle}" Foreground="#72FFFFFF" FontSize="10" TextWrapping="Wrap" LineHeight="15" Margin="0,5,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0"><TextBlock Text="BASELINE" Foreground="#48FFFFFF" FontSize="9" FontWeight="SemiBold"/><TextBox Text="{Binding OldValue, Mode=OneWay}" Foreground="#A0FFFFFF" Style="{StaticResource SelectableValue}" Margin="-5,2,0,0"/></StackPanel>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,14,0"><TextBlock Text="CURRENT" Foreground="#48FFFFFF" FontSize="9" FontWeight="SemiBold"/><TextBox Text="{Binding NewValue, Mode=OneWay}" Foreground="{Binding CurrentValueForeground}" FontWeight="SemiBold" Style="{StaticResource SelectableValue}" Margin="-5,2,0,0"/></StackPanel>
                                                    <StackPanel Grid.Column="3" VerticalAlignment="Center"><Border HorizontalAlignment="Left" CornerRadius="7" Padding="9,4" Background="{Binding ResultBackground}" BorderThickness="0"><TextBlock Text="{Binding ResultTitle}" Foreground="{Binding ResultForeground}" FontSize="10" FontWeight="SemiBold"/></Border><TextBlock Text="{Binding ResultDetail}" Foreground="#82FFFFFF" FontSize="10" TextWrapping="Wrap" LineHeight="15" Margin="0,6,0,0"/></StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="RowBorder" Property="IsMouseOver" Value="True"><Setter TargetName="RowBorder" Property="Opacity" Value="0.94"/></Trigger>
                                        <DataTrigger Binding="{Binding StrikeOldValue}" Value="True"><Setter TargetName="txtOld" Property="Opacity" Value="0.58"/></DataTrigger>
                                        <DataTrigger Binding="{Binding IsGroupHeader}" Value="True"><Setter TargetName="RegularRow" Property="Visibility" Value="Collapsed"/><Setter TargetName="GroupHeader" Property="Visibility" Value="Visible"/><Setter TargetName="RowBorder" Property="Margin" Value="0,4,0,9"/><Setter TargetName="RowBorder" Property="Padding" Value="17,16"/></DataTrigger>
                                        <DataTrigger Binding="{Binding IsSectionHeader}" Value="True"><Setter TargetName="SectionBanner" Property="Visibility" Value="Visible"/><Setter TargetName="RowBorder" Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
